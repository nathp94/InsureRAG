# Copiez ce fichier en .env puis adaptez les valeurs. Toutes sont optionnelles.

# --- Appareil : "cuda" ou "cpu" (auto-detecte si absent) ----------------
# INSURERAG_DEVICE=cuda

# --- Modeles -------------------------------------------------------------
# INSURERAG_EMBED_MODEL=intfloat/multilingual-e5-base
# INSURERAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM (serveur Ollama) -----------------------------------------------
# Verifiez les modeles dispo avec : ollama list
# INSURERAG_LLM_MODEL=llama3.2:3b
# INSURERAG_OLLAMA_HOST=http://localhost:11434
# INSURERAG_LLM_NUM_CTX=8192
# INSURERAG_LLM_NUM_PREDICT=512
# INSURERAG_LLM_TEMPERATURE=0

# --- Indexation / chunking ----------------------------------------------
# INSURERAG_COLLECTION=insurerag
# INSURERAG_CHUNK_MAX_TOKENS=400

# --- Recherche -----------------------------------------------------------
# INSURERAG_TOP_K_DENSE=20
# INSURERAG_TOP_K_BM25=20
# INSURERAG_TOP_K_FUSION=20
# INSURERAG_TOP_K_RERANK=5
# INSURERAG_RRF_K=60
